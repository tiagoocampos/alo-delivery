generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// ENUMS
// =========================================================

enum Role {
  platform_admin
  store_owner
  store_staff
}

enum OrderStatus {
  novo
  preparo
  transporte
  entregue
  cancelado
}

enum PaymentMethod {
  pix_manual
  na_entrega
}

enum CanceledBy {
  customer
  store
}

enum ProductBadge {
  mais_pedido
  promocao
  novo
}

enum SubscriptionStatus {
  trial
  active
  overdue
  canceled
}

// =========================================================
// TENANT — cada lojista
// =========================================================

model Tenant {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  phone             String?
  deliveryFee       Int      @default(0) @map("delivery_fee") // centavos
  isActive          Boolean  @default(true) @map("is_active")
  logoUrl           String?  @map("logo_url")
  bannerUrl         String?  @map("banner_url")
  faviconUrl        String?  @map("favicon_url")
  description       String?
  address           String?
  instagramUrl      String?  @map("instagram_url")
  pixKey            String?  @map("pix_key")
  minimumOrderValue Int      @default(0) @map("minimum_order_value") // centavos
  businessHours     Json?    @map("business_hours")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  users         User[]
  categories    Category[]
  products      Product[]
  orders        Order[]
  loyaltyPoints LoyaltyPoint[]
  customers     Customer[]
  subscription  Subscription?
  payments      PlatformPayment[]

  @@map("tenants")
}

// =========================================================
// SUBSCRIPTION — assinatura do lojista na plataforma (lançada manualmente
// pelo dono do SaaS; não existe cobrança automatizada ainda).
// =========================================================

model Subscription {
  id           String             @id @default(uuid())
  tenantId     String             @unique @map("tenant_id")
  planName     String             @map("plan_name")
  monthlyPrice Int                @map("monthly_price") // centavos
  status       SubscriptionStatus @default(trial)
  startedAt    DateTime           @default(now()) @map("started_at")
  canceledAt   DateTime?          @map("canceled_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// =========================================================
// PLATFORM PAYMENT — pagamento recebido do lojista, lançado manualmente
// pelo dono do SaaS (Pix, transferência, etc. fora do sistema).
// =========================================================

model PlatformPayment {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  amount   Int // centavos, valor efetivamente recebido
  paidAt   DateTime @map("paid_at")
  note     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paidAt])
  @@map("platform_payments")
}

// =========================================================
// PLATFORM EXPENSE — custo operacional da plataforma (hospedagem,
// ferramentas, etc.), sem vínculo com nenhum tenant.
// =========================================================

model PlatformExpense {
  id          String   @id @default(uuid())
  description String
  category    String? // ex: "Hospedagem", "Ferramentas", "Marketing" — texto livre, sem enum fixo por enquanto
  amount      Int // centavos
  date        DateTime
  isRecurring Boolean  @default(false) @map("is_recurring")

  @@index([date])
  @@map("platform_expenses")
}

// =========================================================
// USER — quem acessa o painel (dono, atendente, super-admin)
// =========================================================

model User {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id") // null para platform_admin
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(store_staff)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  @@map("users")
}

// =========================================================
// PASSWORD RESET TOKEN — recuperação de senha do User (lojista/atendente/
// platform_admin). Não cobre o login de Customer (cliente final).
// =========================================================

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// =========================================================
// CATEGORY
// =========================================================

model Category {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]
  sizes    CategorySize[]
  crusts   CategoryCrust[]

  @@index([tenantId])
  @@map("categories")
}

// =========================================================
// CATEGORY SIZE — tamanho de categoria (ex: pizza P/M/G). Define o
// preço final do produto nesse tamanho e quantos sabores ele permite.
// =========================================================

model CategorySize {
  id         String @id @default(uuid())
  categoryId String @map("category_id")
  name       String // "Pequena", "Média", "Grande"
  price      Int // preço final do produto nesse tamanho, em centavos
  maxFlavors Int    @map("max_flavors") // quantos sabores esse tamanho permite escolher

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([categoryId])
  @@map("category_sizes")
}

// =========================================================
// CATEGORY CRUST — borda opcional da categoria, com preço próprio,
// independente do tamanho escolhido.
// =========================================================

model CategoryCrust {
  id         String @id @default(uuid())
  categoryId String @map("category_id")
  name       String // "Cheddar", "Catupiry", "Doce de leite"
  priceDelta Int    @default(0) @map("price_delta") // centavos

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([categoryId])
  @@map("category_crusts")
}

// =========================================================
// PRODUCT
// =========================================================

model Product {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  categoryId  String        @map("category_id")
  name        String
  description String?
  imageUrl    String?       @map("image_url")
  basePrice   Int?          @map("base_price") // centavos — opcional: null quando o produto é um "sabor" de uma categoria com tamanho
  isActive    Boolean       @default(true) @map("is_active")
  badge       ProductBadge?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category          @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  orderItems       OrderItem[]
  orderItemFlavors OrderItemFlavor[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

// =========================================================
// PRODUCT VARIANT — variação simples de produto de categoria sem tamanho
// (ex: ponto da carne de um xis, tamanho de uma bebida).
// =========================================================

model ProductVariant {
  id         String @id @default(uuid())
  productId  String @map("product_id")
  name       String // "Pequena", "Grande", "Com bacon"
  priceDelta Int    @default(0) @map("price_delta") // soma/subtrai do basePrice, em centavos

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// =========================================================
// ORDER
// =========================================================

model Order {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  customerId    String?       @map("customer_id")
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  address       String
  status        OrderStatus   @default(novo)
  subtotal      Int // centavos
  deliveryFee   Int           @map("delivery_fee") // centavos
  total         Int // centavos
  paymentMethod PaymentMethod @map("payment_method")
  cancelReason  String?       @map("cancel_reason")
  canceledBy    CanceledBy?   @map("canceled_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer?               @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  pushSubscriptions OrderPushSubscription[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("orders")
}

// =========================================================
// ORDER PUSH SUBSCRIPTION — inscrição de notificação push vinculada a um
// pedido específico (não a uma conta de cliente — funciona pra convidado também).
// =========================================================

model OrderPushSubscription {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  endpoint  String
  p256dhKey String   @map("p256dh_key")
  authKey   String   @map("auth_key")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_push_subscriptions")
}

// =========================================================
// ORDER ITEM
// =========================================================

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  productId       String? @map("product_id") // opcional — null quando o item é do tipo "tamanho+sabores"
  variantId       String? @map("variant_id") // continua igual, para produtos de categoria sem tamanho
  categorySizeId  String? @map("category_size_id") // preenchido só quando o item usa tamanho de categoria
  categoryCrustId String? @map("category_crust_id")
  quantity        Int
  unitPrice       Int     @map("unit_price") // centavos — preço travado no momento do pedido
  note            String?

  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?          @relation(fields: [productId], references: [id])
  variant       ProductVariant?   @relation(fields: [variantId], references: [id])
  categorySize  CategorySize?     @relation(fields: [categorySizeId], references: [id])
  categoryCrust CategoryCrust?    @relation(fields: [categoryCrustId], references: [id])
  flavors       OrderItemFlavor[]

  @@index([orderId])
  @@map("order_items")
}

// =========================================================
// ORDER ITEM FLAVOR — sabor(es) escolhidos num item "tamanho+sabores".
// productName é o nome do sabor congelado no momento do pedido (mesmo
// princípio do unitPrice travado em OrderItem) — o Product em si pode
// ser renomeado/desativado depois sem afetar pedidos antigos.
// =========================================================

model OrderItemFlavor {
  id          String @id @default(uuid())
  orderItemId String @map("order_item_id")
  productId   String @map("product_id")
  productName String @map("product_name")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([orderItemId])
  @@map("order_item_flavors")
}

// =========================================================
// LOYALTY POINTS — fidelização básica (identifica pelo telefone)
// =========================================================

model LoyaltyPoint {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  customerPhone String   @map("customer_phone")
  points        Int      @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerPhone])
  @@index([tenantId])
  @@map("loyalty_points")
}

// =========================================================
// CUSTOMER — conta opcional do cliente final (login não é obrigatório
// para pedir; quem não cria conta continua pedindo como convidado).
// Conta por loja, igual ao LoyaltyPoint: a mesma pessoa cria uma
// conta separada em cada tenant, não existe conta global da plataforma.
// =========================================================

model Customer {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  phone        String
  email        String?
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses Address[]
  orders    Order[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

// =========================================================
// ADDRESS — endereços salvos na conta do cliente final
// =========================================================

model Address {
  id           String  @id @default(uuid())
  customerId   String  @map("customer_id")
  label        String? // "Casa", "Trabalho"
  street       String
  number       String
  complement   String?
  neighborhood String?
  city         String?
  isDefault    Boolean @default(false) @map("is_default")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}
