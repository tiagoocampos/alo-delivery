
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// =========================================================
// ENUMS
// =========================================================

enum Role {
  platform_admin
  store_owner
  store_staff
}

enum OrderStatus {
  novo
  preparo
  transporte
  entregue
  cancelado
}

enum PaymentMethod {
  pix_manual
  na_entrega
}

// =========================================================
// TENANT — cada lojista
// =========================================================

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  phone        String?
  deliveryFee  Int      @default(0) @map("delivery_fee") // centavos
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users          User[]
  categories     Category[]
  products       Product[]
  orders         Order[]
  loyaltyPoints  LoyaltyPoint[]
  customers      Customer[]

  @@map("tenants")
}

// =========================================================
// USER — quem acessa o painel (dono, atendente, super-admin)
// =========================================================

model User {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id") // null para platform_admin
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(store_staff)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

// =========================================================
// CATEGORY
// =========================================================

model Category {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("categories")
}

// =========================================================
// PRODUCT
// =========================================================

model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  categoryId  String   @map("category_id")
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  basePrice   Int      @map("base_price") // centavos
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

// =========================================================
// PRODUCT VARIANT — tamanho de pizza, ponto do xis, etc.
// =========================================================

model ProductVariant {
  id         String @id @default(uuid())
  productId  String @map("product_id")
  name       String // "Pequena", "Grande", "Com bacon"
  priceDelta Int    @default(0) @map("price_delta") // soma/subtrai do basePrice, em centavos

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// =========================================================
// ORDER
// =========================================================

model Order {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  customerId     String?       @map("customer_id")
  customerName   String        @map("customer_name")
  customerPhone  String        @map("customer_phone")
  address        String
  status         OrderStatus   @default(novo)
  subtotal       Int // centavos
  deliveryFee    Int           @map("delivery_fee") // centavos
  total          Int // centavos
  paymentMethod  PaymentMethod @map("payment_method")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("orders")
}

// =========================================================
// ORDER ITEM
// =========================================================

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  quantity  Int
  unitPrice Int     @map("unit_price") // centavos — preço travado no momento do pedido
  note      String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// =========================================================
// LOYALTY POINTS — fidelização básica (identifica pelo telefone)
// =========================================================

model LoyaltyPoint {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  customerPhone String   @map("customer_phone")
  points        Int      @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerPhone])
  @@index([tenantId])
  @@map("loyalty_points")
}

// =========================================================
// CUSTOMER — conta opcional do cliente final (login não é obrigatório
// para pedir; quem não cria conta continua pedindo como convidado).
// Conta por loja, igual ao LoyaltyPoint: a mesma pessoa cria uma
// conta separada em cada tenant, não existe conta global da plataforma.
// =========================================================

model Customer {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  phone        String
  email        String?
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses Address[]
  orders    Order[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

// =========================================================
// ADDRESS — endereços salvos na conta do cliente final
// =========================================================

model Address {
  id           String  @id @default(uuid())
  customerId   String  @map("customer_id")
  label        String? // "Casa", "Trabalho"
  street       String
  number       String
  complement   String?
  neighborhood String?
  city         String?
  isDefault    Boolean @default(false) @map("is_default")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}
